{
  "name": "@cms/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typeorm": "typeorm-ts-node-commonjs -d src/data-source.ts",
    "migration:generate": "pnpm run typeorm migration:generate",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "pnpm run typeorm migration:run",
    "migration:revert": "pnpm run typeorm migration:revert",
    "migration:show": "pnpm run typeorm migration:show",
    "seed": "ts-node src/seeds/run-seeds.ts"
  },
  "dependencies": {
    "@cms/domain": "workspace:*",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@cms/configs": "workspace:*",
    "@cms/linting": "workspace:*",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
