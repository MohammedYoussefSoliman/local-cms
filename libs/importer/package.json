  },
  "devDependencies": {
    "@cms/configs": "workspace:*",
    "@cms/linting": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsconfig-paths": "^4.2.0"
