# --- Server ---
NODE_ENV=development
PORT=4050
API_PREFIX=api
# Seconds. `Cache-Control: max-age` on the runtime bundle reads.
RUNTIME_CACHE_MAX_AGE=60

# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=cms
DATABASE_PASSWORD=cms
DATABASE_NAME=localization_cms
DATABASE_LOGGING=false

# --- JWT ---
# Never commit real values. Load from the deployment secret manager (arch doc §5).
# Both placeholders below are deliberately shorter than the 32-character
# minimum, so copying this file unedited fails at boot rather than running on a
# secret that is public in git history. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-in-every-environment
JWT_REFRESH_SECRET=change-me-too-and-differently
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=local-cms
JWT_AUDIENCE=local-cms-dashboard

# --- Invitations ---
# Where the dashboard is served from. The API mints the invitation token; only
# this knows the URL that can spend it, so the accept link is built from both.
DASHBOARD_URL=http://localhost:4051
# How long an invitation stays acceptable: long enough to survive a weekend,
# short enough that a token forwarded in an old email thread is already dead.
INVITE_TTL=7d

# --- CORS ---
CORS_ORIGINS=http://localhost:4051

# --- Bootstrap admin (read by `pnpm seed`, NOT by the API) ---
# A fresh install has no users, so nothing is reachable until this runs.
# Leave both unset to skip the admin seed; setting only one is an error.
# Re-running the seed never touches an admin that already exists, so rotating
# this password here does not change the account.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-12-chars
