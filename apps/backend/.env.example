# --- Server ---
NODE_ENV=development
PORT=4050
API_PREFIX=api

# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=cms
DATABASE_PASSWORD=cms
DATABASE_NAME=localization_cms
DATABASE_LOGGING=false

# --- JWT ---
# Never commit real values. Load from the deployment secret manager (arch doc §5).
JWT_ACCESS_SECRET=change-me-in-every-environment
JWT_REFRESH_SECRET=change-me-too-and-make-it-different
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=local-cms
JWT_AUDIENCE=local-cms-dashboard

# --- CORS ---
CORS_ORIGINS=http://localhost:4051
